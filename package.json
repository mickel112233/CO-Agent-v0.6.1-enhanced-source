{
  "name": "co-agent-desktop",
  "version": "0.6.1",
  "private": true,
  "description": "CO-Agent — a local-first AI agent workspace for desktop.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "npm run build && node electron/launch-local.cjs",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "test": "node --test --test-concurrency=1 test/*.test.cjs",
    "build:pet:win": "npm ci --prefix integrations/AI-Desktop-Pet && npm run build --prefix integrations/AI-Desktop-Pet && cargo build --release --manifest-path integrations/AI-Desktop-Pet/src-tauri/Cargo.toml"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^44.5.1",
    "electron-builder": "26.15.3",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.coagent.desktop",
    "productName": "CO-Agent",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "scripts/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "extraResources": [
      {
        "from": "third_party/LuxTTS",
        "to": "luxtts/LuxTTS",
        "filter": [
          "**/*",
          "!**/.git/**"
        ]
      },
      {
        "from": "scripts/luxtts-worker.py",
        "to": "scripts/luxtts-worker.py"
      }
    ],
    "afterPack": "scripts/after-pack.cjs"
  }
}
